# Copy to .env.local for development. Real values go in
# Vercel → Settings → Environment Variables. .env* is gitignored.

# --- Contact form -----------------------------------------------------------
# From resend.com/api-keys
RESEND_KEY=
# Optional. Must be on a domain verified in Resend. Defaults to Resend's
# onboarding@resend.dev, which only delivers to the account owner.
CONTACT_FROM_EMAIL=
# Optional. Defaults to company.email in src/lib/content/site.ts
CONTACT_TO_EMAIL=

# --- Supabase ---------------------------------------------------------------
# Project Settings → API. Both are PUBLIC by design: the anon key is safe in
# the browser bundle because row-level security, not key secrecy, protects the
# data. Auth stays switched off until both are set — every entry point falls
# back to the application form rather than opening a login box with nothing
# behind it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security entirely — never prefix this with
# NEXT_PUBLIC_, never import it into a client component.
#
# Required for Python submission checking, and nothing else. A student may
# lodge an attempt but must never judge one, so the verdict columns and the
# progress rows a pass earns are closed to them by policy — the grading route
# is the only thing that writes them. Without this key that route returns a
# clear message and the rest of the site is unaffected.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ------------------------------------------------------------------
# Who may reach /admin, comma-separated. A second gate on top of
# profiles.role = 'admin' — both must pass. Defaults to the owner's account
# so the panel is never locked out by a missing variable.
ADMIN_EMAILS=satyaprakashreddy6789@gmail.com

# --- AI grading -------------------------------------------------------------
# From aistudio.google.com. Reads the screenshot a student uploads as proof of
# an accepted LeetCode submission.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Defaults to gemini-3.6-flash, which is what Google's own
# deprecation notice for 2.5-flash points new projects at.
GEMINI_MODEL=

# --- Python judge -----------------------------------------------------------
# The code runner on Railway (services/judge). JUDGE_TOKEN must match the value
# set on that service; without both, the Python track says so rather than
# silently accepting everything.
JUDGE_URL=
JUDGE_TOKEN=

# --- Optional ---------------------------------------------------------------
# Only needed if Search Console is verified by HTML tag rather than DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
