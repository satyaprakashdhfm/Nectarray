# Copy to .env.local for development. Real values go in
# Vercel → Settings → Environment Variables. .env* is gitignored.

# --- Contact form -----------------------------------------------------------
# From resend.com/api-keys
RESEND_KEY=
# Optional. Must be on a domain verified in Resend. Defaults to Resend's
# onboarding@resend.dev, which only delivers to the account owner.
CONTACT_FROM_EMAIL=
# Optional. Defaults to company.email in src/lib/content/site.ts
CONTACT_TO_EMAIL=

# --- Supabase ---------------------------------------------------------------
# Project Settings → API. Both are PUBLIC by design: the anon key is safe in
# the browser bundle because row-level security, not key secrecy, protects the
# data. Auth stays switched off until both are set — every entry point falls
# back to the application form rather than opening a login box with nothing
# behind it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security entirely — never prefix this with
# NEXT_PUBLIC_, never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI grading -------------------------------------------------------------
# From aistudio.google.com. Used by the Vercel AI SDK to score assignments.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Optional ---------------------------------------------------------------
# Only needed if Search Console is verified by HTML tag rather than DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
